# ---- AI provider ----
# Choose which provider the factory builds: "openrouter" or "openai".
PROVIDER=openrouter
# OpenAI-compatible base URL.
AI_BASE_URL=https://openrouter.ai/api/v1
# Free OpenRouter model. Swap for e.g. gpt-4o-mini when using PROVIDER=openai.
MODEL=meta-llama/llama-3.3-70b-instruct:free
# API key. For OpenRouter free models this is OPTIONAL; for OpenAI it is required.
# Never commit a real key.
API_KEY=your-api-key-here

# --- Request behaviour ---
AI_TIMEOUT_SECONDS=30.0
SUMMARY_MAX_TOKENS=180
SUMMARY_TEMPERATURE=0.4
INPUT_MAX_WORDS=1500

# --- Resilience ---
TENACITY_RETRIES=3
TENACITY_BACKOFF_SECONDS=1.0

# --- Caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60